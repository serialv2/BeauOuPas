<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:BeauOuPas"
             xmlns:converters="clr-namespace:BeauOuPas.Converters"
             x:Class="BeauOuPas.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
            <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
            <converters:BoolToTextColorConverter x:Key="BoolToTextColorConverter"/>
            <converters:StringToBoolConverter x:Key="StringToBoolConverter"/>
            <!-- ⚡ NOUVEAU : pour les cartes sélectionnables dans les formulaires -->
            <converters:BoolToSelectedBgConverter x:Key="BoolToSelectedBgConverter"/>
            <!-- ⚡ NOUVEAU : pour gérer null vs valeur (PhotoSource, etc.) -->
            <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
            <!-- 🔧 quiz-fix3 : converters utilisés par EditQuizQuestionPage
                 (les classes existent déjà dans Converters/QuizConverters.cs,
                 il manquait juste leur déclaration ici) -->
            <converters:BoolToCorrectBgConverter x:Key="BoolToCorrectBgConverter"/>
            <converters:BoolToCheckEmojiConverter x:Key="BoolToCheckEmojiConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
