<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BeauOuPas.Views.Groups.CreateSeriesProjectPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:BeauOuPas.ViewModels.Groups"
        xmlns:tr="clr-namespace:BeauOuPas.Extensions"
x:DataType="vm:CreateSeriesProjectViewModel"
    Title="Nouveau projet"
    BackgroundColor="{StaticResource BackgroundPage}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Annuler" Command="{Binding CancelCommand}"/>
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="16,12">

            <Label Text="{tr:Translate Key=CreateSeriesProject_Title}"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   Margin="0,0,0,4"/>
            <Label Text="{Binding SeriesTitle}"
                   FontSize="14"
                   TextColor="{StaticResource Primary}"
                   Margin="0,0,0,20"/>

            <!-- ─── Sélection type ─────────────────────────────── -->
            <Label Text="Type de projet"
                   FontSize="15"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   Margin="0,0,0,10"/>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,0,0,20">
                <!-- Photo vote -->
                <Border Grid.Column="0"
                        BackgroundColor="{Binding IsPhotoType, Converter={StaticResource BoolToColorConverter}}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource Primary}"
                        StrokeThickness="1"
                        Padding="0,14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectTypeCommand}" CommandParameter="photo_vote"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="📷" FontSize="22" HorizontalOptions="Center"/>
                        <Label Text="Photo" FontSize="12" FontAttributes="Bold"
                               TextColor="{Binding IsPhotoType, Converter={StaticResource BoolToTextColorConverter}}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
                <!-- Duel -->
                <Border Grid.Column="1"
                        BackgroundColor="{Binding IsDuelType, Converter={StaticResource BoolToColorConverter}}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource Primary}"
                        StrokeThickness="1"
                        Padding="0,14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectTypeCommand}" CommandParameter="duel"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="⚖️" FontSize="22" HorizontalOptions="Center"/>
                        <Label Text="Duel" FontSize="12" FontAttributes="Bold"
                               TextColor="{Binding IsDuelType, Converter={StaticResource BoolToTextColorConverter}}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
                <!-- Sondage -->
                <Border Grid.Column="2"
                        BackgroundColor="{Binding IsPollType, Converter={StaticResource BoolToColorConverter}}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource Primary}"
                        StrokeThickness="1"
                        Padding="0,14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectTypeCommand}" CommandParameter="poll"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="📊" FontSize="22" HorizontalOptions="Center"/>
                        <Label Text="Sondage" FontSize="12" FontAttributes="Bold"
                               TextColor="{Binding IsPollType, Converter={StaticResource BoolToTextColorConverter}}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- ─── Titre ──────────────────────────────────────── -->
            <Border BackgroundColor="White"
                    StrokeShape="RoundRectangle 14"
                    Stroke="{StaticResource BorderLight}"
                    StrokeThickness="1"
                    Padding="16"
                    Margin="0,0,0,12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Titre *" FontSize="13" FontAttributes="Bold"
                           TextColor="{StaticResource TextTertiary}" TextTransform="Uppercase"/>
                    <Entry Placeholder="Ex: Qui est le plus beau ?"
                           Text="{Binding Title}"
                           FontSize="16" TextColor="{StaticResource TextPrimary}"
                           PlaceholderColor="{StaticResource TextDisabled}"
                           BackgroundColor="Transparent"/>
                </VerticalStackLayout>
            </Border>

            <!-- ─── Description ───────────────────────────────── -->
            <Border BackgroundColor="White"
                    StrokeShape="RoundRectangle 14"
                    Stroke="{StaticResource BorderLight}"
                    StrokeThickness="1"
                    Padding="16"
                    Margin="0,0,0,20">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Description" FontSize="13" FontAttributes="Bold"
                           TextColor="{StaticResource TextTertiary}" TextTransform="Uppercase"/>
                    <Editor Placeholder="Optionnel..."
                            Text="{Binding Description}"
                            FontSize="15" TextColor="{StaticResource TextPrimary}"
                            PlaceholderColor="{StaticResource TextDisabled}"
                            BackgroundColor="Transparent"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="50"/>
                </VerticalStackLayout>
            </Border>

            <!-- ─── PHOTO VOTE ─────────────────────────────────── -->
            <VerticalStackLayout IsVisible="{Binding IsPhotoType}" Spacing="12" Margin="0,0,0,20">
                <Label Text="Photo" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                <Border BackgroundColor="White"
                        StrokeShape="RoundRectangle 14"
                        Stroke="{StaticResource BorderLight}"
                        StrokeThickness="1"
                        HeightRequest="200">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PickPhotoCommand}"/>
                    </Border.GestureRecognizers>
                    <Grid>
                        <VerticalStackLayout IsVisible="{Binding PhotoSource, Converter={StaticResource NullToBoolConverter}, ConverterParameter=inverse}"
                                             VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                            <Label Text="📷" FontSize="40" HorizontalOptions="Center"/>
                            <Label Text="Appuyer pour choisir une photo"
                                   FontSize="13" TextColor="{StaticResource TextTertiary}" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                        <Image Source="{Binding PhotoSource}"
                               IsVisible="{Binding PhotoSource, Converter={StaticResource NullToBoolConverter}}"
                               Aspect="AspectFill"/>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- ─── DUEL ───────────────────────────────────────── -->
            <VerticalStackLayout IsVisible="{Binding IsDuelType}" Spacing="12" Margin="0,0,0,20">
                <Label Text="{tr:Translate Key=CreateSeriesProject_DuelHint}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <!-- Photo A -->
                    <Border Grid.Column="0"
                            BackgroundColor="White"
                            StrokeShape="RoundRectangle 14"
                            Stroke="{StaticResource BorderLight}"
                            StrokeThickness="1"
                            HeightRequest="160">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PickPhotoLeftCommand}"/>
                        </Border.GestureRecognizers>
                        <Grid>
                            <VerticalStackLayout IsVisible="{Binding PhotoLeftSource, Converter={StaticResource NullToBoolConverter}, ConverterParameter=inverse}"
                                                 VerticalOptions="Center" HorizontalOptions="Center" Spacing="6">
                                <Label Text="📷" FontSize="32" HorizontalOptions="Center"/>
                                <Label Text="Photo A" FontSize="13" FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                            <Image Source="{Binding PhotoLeftSource}"
                                   IsVisible="{Binding PhotoLeftSource, Converter={StaticResource NullToBoolConverter}}"
                                   Aspect="AspectFill"/>
                        </Grid>
                    </Border>
                    <!-- Photo B -->
                    <Border Grid.Column="1"
                            BackgroundColor="White"
                            StrokeShape="RoundRectangle 14"
                            Stroke="{StaticResource BorderLight}"
                            StrokeThickness="1"
                            HeightRequest="160">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PickPhotoRightCommand}"/>
                        </Border.GestureRecognizers>
                        <Grid>
                            <VerticalStackLayout IsVisible="{Binding PhotoRightSource, Converter={StaticResource NullToBoolConverter}, ConverterParameter=inverse}"
                                                 VerticalOptions="Center" HorizontalOptions="Center" Spacing="6">
                                <Label Text="📷" FontSize="32" HorizontalOptions="Center"/>
                                <Label Text="Photo B" FontSize="13" FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                            <Image Source="{Binding PhotoRightSource}"
                                   IsVisible="{Binding PhotoRightSource, Converter={StaticResource NullToBoolConverter}}"
                                   Aspect="AspectFill"/>
                        </Grid>
                    </Border>
                </Grid>
            </VerticalStackLayout>

            <!-- ─── SONDAGE ────────────────────────────────────── -->
            <VerticalStackLayout IsVisible="{Binding IsPollType}" Spacing="10" Margin="0,0,0,20">
                <Label Text="Options (2 minimum)" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                <Border BackgroundColor="White" StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource BorderLight}" StrokeThickness="1" Padding="14,10">
                    <Entry Placeholder="Option 1 *" Text="{Binding Option1}"
                           FontSize="15" TextColor="{StaticResource TextPrimary}" PlaceholderColor="{StaticResource TextDisabled}"
                           BackgroundColor="Transparent"/>
                </Border>
                <Border BackgroundColor="White" StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource BorderLight}" StrokeThickness="1" Padding="14,10">
                    <Entry Placeholder="Option 2 *" Text="{Binding Option2}"
                           FontSize="15" TextColor="{StaticResource TextPrimary}" PlaceholderColor="{StaticResource TextDisabled}"
                           BackgroundColor="Transparent"/>
                </Border>
                <Border BackgroundColor="White" StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource BorderLight}" StrokeThickness="1" Padding="14,10">
                    <Entry Placeholder="Option 3 (facultatif)" Text="{Binding Option3}"
                           FontSize="15" TextColor="{StaticResource TextPrimary}" PlaceholderColor="{StaticResource TextDisabled}"
                           BackgroundColor="Transparent"/>
                </Border>
                <Border BackgroundColor="White" StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource BorderLight}" StrokeThickness="1" Padding="14,10">
                    <Entry Placeholder="Option 4 (facultatif)" Text="{Binding Option4}"
                           FontSize="15" TextColor="{StaticResource TextPrimary}" PlaceholderColor="{StaticResource TextDisabled}"
                           BackgroundColor="Transparent"/>
                </Border>
            </VerticalStackLayout>

            <!-- ─── Selfie automatique (par projet) ───────────── -->
            <Border BackgroundColor="White"
                    StrokeShape="RoundRectangle 14"
                    Stroke="{StaticResource BorderLight}"
                    StrokeThickness="1"
                    Padding="16,12"
                    Margin="0,0,0,20">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                        <Label Text="📸 Selfie automatique"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"/>
                        <Label Text="Capture le selfie des votants pendant le countdown"
                               FontSize="12" TextColor="{StaticResource TextTertiary}"/>
                    </VerticalStackLayout>
                    <Switch Grid.Column="1"
                            IsToggled="{Binding SelfieEnabled, Mode=TwoWay}"
                            OnColor="{StaticResource Primary}"
                            ThumbColor="White"
                            VerticalOptions="Center"/>
                </Grid>
            </Border>

            <!-- ─── Bouton créer ──────────────────────────────── -->
            <Border BackgroundColor="{StaticResource Primary}"
                    StrokeShape="RoundRectangle 16"
                    Stroke="Transparent"
                    Padding="0,16"
                    Margin="0,0,0,40">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CreateCommand}"/>
                </Border.GestureRecognizers>
                <Grid>
                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       IsVisible="{Binding IsLoading}"
                                       Color="White"/>
                    <Label Text="{tr:Translate Key=CreateSeriesProject_AddButton}"
                           IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                           FontSize="16" FontAttributes="Bold"
                           TextColor="White" HorizontalOptions="Center"/>
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
