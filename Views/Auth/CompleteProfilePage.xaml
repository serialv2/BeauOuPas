<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BeauOuPas.Views.Auth.CompleteProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:BeauOuPas.ViewModels.Auth"
    xmlns:tr="clr-namespace:BeauOuPas.Extensions"
    x:DataType="vm:CompleteProfileViewModel"
    Title="{tr:Translate Key=CompleteProfile_Title}"
    BackgroundColor="{StaticResource BackgroundPage}"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="28,40,28,28" Spacing="20">

            <!-- Header -->
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Label Text="👤" FontSize="56" HorizontalOptions="Center"/>
                <Label Text="{tr:Translate Key=CompleteProfile_Title}"
                       FontSize="24" FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"/>
                <Label Text="{tr:Translate Key=CompleteProfile_Subtitle}"
                       FontSize="14" TextColor="{StaticResource TextTertiary}"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <!-- Pseudo -->
            <VerticalStackLayout Spacing="6">
                <Label Text="{tr:Translate Key=CompleteProfile_Username}"
                       FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                <Border Stroke="{StaticResource BorderMedium}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 10" BackgroundColor="White">
                    <Entry Text="{Binding Username}"
                           Placeholder="{tr:Translate Key=Profile_UsernamePlaceholder}"
                           PlaceholderColor="{StaticResource TextDisabled}" Margin="14,0"/>
                </Border>
            </VerticalStackLayout>

            <!-- Date de naissance -->
            <VerticalStackLayout Spacing="6">
                <Label Text="{tr:Translate Key=CompleteProfile_BirthDate}"
                       FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                <Border Stroke="{StaticResource BorderMedium}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 10" BackgroundColor="White"
                        Padding="14,12">
                    <DatePicker Date="{Binding BirthDate}"
                                MaximumDate="{Binding MaxBirthDate}"
                                MinimumDate="{Binding MinBirthDate}"
                                Format="dd/MM/yyyy"
                                TextColor="{StaticResource TextPrimary}"/>
                </Border>
                <Label Text="{Binding AgeError}"
                       IsVisible="{Binding HasAgeError}"
                       FontSize="12" TextColor="{StaticResource Error}"/>
            </VerticalStackLayout>

            <!-- Genre -->
            <VerticalStackLayout Spacing="6">
                <Label Text="{tr:Translate Key=CompleteProfile_Gender}"
                       FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                <Border Stroke="{StaticResource BorderMedium}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 10" BackgroundColor="White">
                    <Picker ItemsSource="{Binding GenderOptions}"
                            SelectedItem="{Binding SelectedGender}"
                            TitleColor="{StaticResource TextDisabled}" TextColor="{StaticResource TextPrimary}" Margin="14,0"/>
                </Border>
            </VerticalStackLayout>

            <!-- Préférence projets -->
            <VerticalStackLayout Spacing="6">
                <Label Text="{tr:Translate Key=CompleteProfile_ProjectPref}"
                       FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="{tr:Translate Key=Common_Male}"
                            Command="{Binding SelectPrefMaleCommand}"
                            BackgroundColor="{Binding PrefMaleColor}"
                            TextColor="{Binding PrefMaleTextColor}"
                            CornerRadius="10" HeightRequest="44"/>
                    <Button Grid.Column="1" Text="{tr:Translate Key=Common_Female}"
                            Command="{Binding SelectPrefFemaleCommand}"
                            BackgroundColor="{Binding PrefFemaleColor}"
                            TextColor="{Binding PrefFemaleTextColor}"
                            CornerRadius="10" HeightRequest="44"/>
                    <Button Grid.Column="2" Text="{tr:Translate Key=Common_Other}"
                            Command="{Binding SelectPrefOtherCommand}"
                            BackgroundColor="{Binding PrefOtherColor}"
                            TextColor="{Binding PrefOtherTextColor}"
                            CornerRadius="10" HeightRequest="44"/>
                </Grid>
            </VerticalStackLayout>

            <!-- Géolocalisation -->
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 12"
                    Stroke="{StaticResource BorderLight}" StrokeThickness="1" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="📍" FontSize="24" VerticalOptions="Center"/>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="{tr:Translate Key=CompleteProfile_Location}"
                                   FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                            <Label Text="{tr:Translate Key=CompleteProfile_LocationHint}"
                                   FontSize="12" TextColor="{StaticResource TextTertiary}"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                    <Button Text="{Binding LocationButtonText}"
                            Command="{Binding RequestLocationCommand}"
                            BackgroundColor="{Binding LocationButtonColor}"
                            TextColor="White" CornerRadius="8" HeightRequest="40"/>
                </VerticalStackLayout>
            </Border>

            <!-- Notifications -->
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 12"
                    Stroke="{StaticResource BorderLight}" StrokeThickness="1" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="🔔" FontSize="24" VerticalOptions="Center"/>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="{tr:Translate Key=CompleteProfile_Notifs}"
                                   FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                            <Label Text="{tr:Translate Key=CompleteProfile_NotifsHint}"
                                   FontSize="12" TextColor="{StaticResource TextTertiary}"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                    <Button Text="{Binding NotifButtonText}"
                            Command="{Binding RequestNotifCommand}"
                            BackgroundColor="{Binding NotifButtonColor}"
                            TextColor="White" CornerRadius="8" HeightRequest="40"/>
                </VerticalStackLayout>
            </Border>

            <!-- Erreur -->
            <Border IsVisible="{Binding HasError}"
                    BackgroundColor="{StaticResource ErrorLight}" Stroke="{StaticResource ErrorLight}"
                    StrokeShape="RoundRectangle 8" Padding="12,8">
                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Error}" FontSize="13"/>
            </Border>

            <!-- Bouton continuer -->
            <Button Text="{tr:Translate Key=CompleteProfile_Continue}"
                    Command="{Binding SaveProfileCommand}"
                    BackgroundColor="{StaticResource Primary}" TextColor="White"
                    CornerRadius="12" HeightRequest="52"
                    FontSize="16" FontAttributes="Bold"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"/>

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="{StaticResource Primary}" HorizontalOptions="Center"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
