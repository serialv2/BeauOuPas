<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BeauOuPas.Views.Home.PickGroupForCreationPage"
    x:Name="ThisPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:BeauOuPas.ViewModels.Home"
    xmlns:models="clr-namespace:BeauOuPas.Models"
    xmlns:tr="clr-namespace:BeauOuPas.Extensions"
    x:DataType="vm:PickGroupForCreationViewModel"
    Title="{tr:Translate Key=PickGroup_Title}"
    BackgroundColor="{StaticResource BackgroundPage}">

    <Grid RowDefinitions="Auto,*">

        <!-- ═══ EN-TÊTE ════════════════════════════════════════════ -->
        <VerticalStackLayout Grid.Row="0" Padding="20,16,20,12">
            <Label Text="{tr:Translate Key=PickGroup_Heading}"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"/>
            <Label Text="{tr:Translate Key=PickGroup_Subheading}"
                   FontSize="13"
                   TextColor="{StaticResource TextTertiary}"
                   Margin="0,4,0,0"/>
        </VerticalStackLayout>

        <!-- ═══ LISTE DES GROUPES ══════════════════════════════════ -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Groups}"
                        SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Padding="40">
                    <Label Text="👥"
                           FontSize="48"
                           HorizontalOptions="Center"
                           Opacity="0.4"/>
                    <Label Text="{tr:Translate Key=PickGroup_Empty}"
                           FontSize="14"
                           TextColor="{StaticResource TextTertiary}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           Margin="0,12,0,0"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Group">
                    <Border BackgroundColor="{StaticResource SurfaceCardAlt}"
                            StrokeShape="RoundRectangle 14"
                            Stroke="{StaticResource BorderLight}"
                            StrokeThickness="1"
                            Padding="14"
                            Margin="20,0,20,0">
                        <Border.GestureRecognizers>
                            <!-- ⚡ x:Reference est plus rapide que RelativeSource AncestorType
                                 (leçon GroupDetailPage v4-v5) -->
                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.PickGroupCommand}"
                                CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <!-- Avatar = pastille avec emoji 👥 -->
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource SurfaceMuted}"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="Transparent"
                                    WidthRequest="44"
                                    HeightRequest="44">
                                <Label Text="👥"
                                       FontSize="22"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                  VerticalOptions="Center">
                                <Label Text="{Binding Name}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"
                                       LineBreakMode="TailTruncation"/>
                                <Label Text="{Binding Description}"
                                       FontSize="12"
                                       TextColor="{StaticResource TextTertiary}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="→"
                                   FontSize="20"
                                   TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
