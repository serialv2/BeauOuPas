<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BeauOuPas.Views.Projects.CreateProjectPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:BeauOuPas.ViewModels.Projects"
    xmlns:tr="clr-namespace:BeauOuPas.Extensions"
    x:DataType="vm:CreateProjectViewModel"
    Title="{tr:Translate Key=Create_Title}"
    BackgroundColor="{StaticResource BackgroundPage}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Indicateur étapes -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Border Grid.Column="0" StrokeShape="RoundRectangle 20"
                        BackgroundColor="{StaticResource Primary}" Padding="8,4">
                    <Label Text="{tr:Translate Key=Create_Step1}" TextColor="{StaticResource TextOnPrimary}"
                           FontSize="12" HorizontalOptions="Center"/>
                </Border>
                <Border Grid.Column="1" StrokeShape="RoundRectangle 20" Padding="8,4">
                    <Border.BackgroundColor>
                        <Binding Path="IsStep2">
                            <Binding.Converter><x:StaticResource Key="BoolToColorConverter"/></Binding.Converter>
                        </Binding>
                    </Border.BackgroundColor>
                    <Label Text="{tr:Translate Key=Create_Step2}" FontSize="12" HorizontalOptions="Center">
                        <Label.TextColor>
                            <Binding Path="IsStep2">
                                <Binding.Converter><x:StaticResource Key="BoolToTextColorConverter"/></Binding.Converter>
                            </Binding>
                        </Label.TextColor>
                    </Label>
                </Border>
                <Border Grid.Column="2" StrokeShape="RoundRectangle 20" Padding="8,4">
                    <Border.BackgroundColor>
                        <Binding Path="IsStep3">
                            <Binding.Converter><x:StaticResource Key="BoolToColorConverter"/></Binding.Converter>
                        </Binding>
                    </Border.BackgroundColor>
                    <Label Text="{tr:Translate Key=Create_Step3}" FontSize="12" HorizontalOptions="Center">
                        <Label.TextColor>
                            <Binding Path="IsStep3">
                                <Binding.Converter><x:StaticResource Key="BoolToTextColorConverter"/></Binding.Converter>
                            </Binding>
                        </Label.TextColor>
                    </Label>
                </Border>
            </Grid>

            <!-- ═══ ÉTAPE 1 ═══ -->
            <VerticalStackLayout IsVisible="{Binding IsStep1}" Spacing="16">
                <Label Text="{tr:Translate Key=Create_WhatSubmit}"
                       FontSize="18" FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"/>

                <!-- Photo unique -->
                <Border StrokeShape="RoundRectangle 15" Stroke="{StaticResource Primary}"
                        StrokeThickness="2" BackgroundColor="{StaticResource SurfaceCardAlt}" Padding="20">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="📷" FontSize="48" HorizontalOptions="Center"/>
                        <Label Text="{tr:Translate Key=Create_SinglePhoto}"
                               FontSize="18" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"/>
                        <Label Text="{tr:Translate Key=Create_SinglePhotoHint}"
                               FontSize="13" TextColor="{StaticResource TextTertiary}" HorizontalOptions="Center"/>
                        <Button Text="{tr:Translate Key=Create_ChooseMode}"
                                Command="{Binding SelectPhotoVoteCommand}"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="{StaticResource TextOnPrimary}"
                                CornerRadius="10" HeightRequest="45"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Duel -->
                <Border StrokeShape="RoundRectangle 15" Stroke="{StaticResource Accent}"
                        StrokeThickness="2" BackgroundColor="{StaticResource SurfaceCardAlt}" Padding="20">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="⚖️" FontSize="48" HorizontalOptions="Center"/>
                        <Label Text="{tr:Translate Key=Create_DualPhoto}"
                               FontSize="18" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"/>
                        <Label Text="{tr:Translate Key=Create_DualPhotoHint}"
                               FontSize="13" TextColor="{StaticResource TextTertiary}" HorizontalOptions="Center"/>
                        <Button Text="{tr:Translate Key=Create_ChooseMode}"
                                Command="{Binding SelectDuelCommand}"
                                BackgroundColor="{StaticResource Accent}"
                                TextColor="{StaticResource TextOnAccent}"
                                CornerRadius="10" HeightRequest="45"/>
                    </VerticalStackLayout>
                </Border>

                <!-- ✅ SONDAGE -->
                <Border StrokeShape="RoundRectangle 15" Stroke="{StaticResource Info}"
                        StrokeThickness="2" BackgroundColor="{StaticResource SurfaceCardAlt}" Padding="20">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="📊" FontSize="48" HorizontalOptions="Center"/>
                        <Label Text="{tr:Translate Key=CreateProject_Survey}"
                               FontSize="18" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"/>
                        <Label Text="{tr:Translate Key=CreateProject_PollHint}"
                               FontSize="13" TextColor="{StaticResource TextTertiary}" HorizontalOptions="Center"/>
                        <Button Text="{tr:Translate Key=Create_ChooseMode}"
                                Command="{Binding SelectPollCommand}"
                                BackgroundColor="{StaticResource Info}" TextColor="White"
                                CornerRadius="10" HeightRequest="45"/>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>

            <!-- ═══ ÉTAPE 2 ═══ -->
            <VerticalStackLayout IsVisible="{Binding IsStep2}" Spacing="16">
                <Label Text="{tr:Translate Key=Create_WhoVote}"
                       FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>

                <!-- Genre -->
                <Border BackgroundColor="{StaticResource SurfaceCardAlt}" StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource BorderLight}" StrokeThickness="1" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{tr:Translate Key=Common_Gender}" FontSize="14"
                               FontAttributes="Bold" TextColor="{StaticResource TextSecondary}"/>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Button Grid.Column="0"
                                    Text="{tr:Translate Key=Create_GenderAll}"
                                    Command="{Binding SelectGenderBothCommand}"
                                    BackgroundColor="{Binding BothColor}"
                                    TextColor="{Binding BothTextColor}"
                                    CornerRadius="8" HeightRequest="40" FontSize="13"/>
                            <Button Grid.Column="1"
                                    Text="{tr:Translate Key=Create_GenderFemale}"
                                    Command="{Binding SelectGenderFemaleCommand}"
                                    BackgroundColor="{Binding FemaleColor}"
                                    TextColor="{Binding FemaleTextColor}"
                                    CornerRadius="8" HeightRequest="40" FontSize="13"/>
                            <Button Grid.Column="2"
                                    Text="{tr:Translate Key=Create_GenderMale}"
                                    Command="{Binding SelectGenderMaleCommand}"
                                    BackgroundColor="{Binding MaleColor}"                                   TextColor="{Binding MaleTextColor}"
                                    CornerRadius="8" HeightRequest="40" FontSize="13"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Tranche d'âge -->
                <Border BackgroundColor="{StaticResource SurfaceCardAlt}" StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource BorderLight}" StrokeThickness="1" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{tr:Translate Key=Create_AgeRange}" FontSize="14"
                               FontAttributes="Bold" TextColor="{StaticResource TextSecondary}"/>
                        <Label FontSize="13" TextColor="{StaticResource Primary}">
                            <Label.Text>
                                <MultiBinding StringFormat="De {0} à {1} ans">
                                    <Binding Path="MinAge"/>
                                    <Binding Path="MaxAge"/>
                                </MultiBinding>
                            </Label.Text>
                        </Label>
                        <Label Text="{tr:Translate Key=Create_AgeMin}" FontSize="12" TextColor="{StaticResource TextTertiary}"/>
                        <Slider Minimum="18" Maximum="99" Value="{Binding MinAge}"
                                MinimumTrackColor="{StaticResource Primary}" ThumbColor="{StaticResource Primary}"/>
                        <Label Text="{tr:Translate Key=Create_AgeMax}" FontSize="12" TextColor="{StaticResource TextTertiary}"/>
                        <Slider Minimum="18" Maximum="99" Value="{Binding MaxAge}"
                                MinimumTrackColor="{StaticResource Primary}" ThumbColor="{StaticResource Primary}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Durée -->
                <Border BackgroundColor="{StaticResource SurfaceCardAlt}" StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource BorderLight}" StrokeThickness="1" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <HorizontalStackLayout Spacing="10">
                            <CheckBox IsChecked="{Binding HasDuration}" Color="{StaticResource Primary}"/>
                            <Label Text="{tr:Translate Key=Create_LimitDuration}"
                                   VerticalOptions="Center" FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                        </HorizontalStackLayout>
                        <VerticalStackLayout IsVisible="{Binding HasDuration}" Spacing="8">
                            <Label FontSize="13" TextColor="{StaticResource Primary}">
                                <Label.Text>
                                    <Binding Path="DurationDays" StringFormat="Durée : {0} jours"/>
                                </Label.Text>
                            </Label>
                            <Slider Minimum="1" Maximum="30" Value="{Binding DurationDays}"
                                    MinimumTrackColor="{StaticResource Primary}" ThumbColor="{StaticResource Primary}"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Projet privé -->
                <Border BackgroundColor="{StaticResource SurfaceCardAlt}" StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource BorderLight}" StrokeThickness="1" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="12">
                            <Switch IsToggled="{Binding IsPrivate}" OnColor="{StaticResource Primary}"/>
                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label Text="{tr:Translate Key=Create_PrivateProjectHint}"
                                       FontSize="14" TextColor="{StaticResource TextPrimary}" FontAttributes="Bold"/>
                                <Label Text="{tr:Translate Key=Create_PrivateProjectWarning}"
                                       FontSize="12" TextColor="{StaticResource TextTertiary}"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                        <Border IsVisible="{Binding IsPrivate}"
                                BackgroundColor="{StaticResource WarningLight}"
                                Stroke="{StaticResource Warning}"
                                StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10,6">
                            <Label Text="{tr:Translate Key=Create_PrivateProjectWarning}"
                                   FontSize="12" TextColor="{StaticResource Warning}"/>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Button Text="{tr:Translate Key=Common_Next}"
                        Command="{Binding GoToStep3Command}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource TextOnPrimary}"
                        CornerRadius="10" HeightRequest="50"
                        FontSize="16" FontAttributes="Bold"/>

                <Button Text="{tr:Translate Key=Common_Back}"
                        Command="{Binding GoBackCommand}"
                        BackgroundColor="{StaticResource SurfaceMuted}"
                        TextColor="{StaticResource TextPrimary}"
                        CornerRadius="10" HeightRequest="45"/>
            </VerticalStackLayout>

            <!-- ═══ ÉTAPE 3 ═══ -->
            <VerticalStackLayout IsVisible="{Binding IsStep3}" Spacing="16">
                <Label Text="{tr:Translate Key=Create_YourProject}"
                       FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>

                <Label Text="{tr:Translate Key=Create_TitleField}" FontSize="13"
                       TextColor="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                <Border Stroke="{StaticResource BorderMedium}" StrokeThickness="1" BackgroundColor="{StaticResource SurfaceCardAlt}"
                        StrokeShape="RoundRectangle 10">
                    <Entry Text="{Binding Title}"
                           Placeholder="{tr:Translate Key=Create_TitlePlaceholder}"
                           PlaceholderColor="{StaticResource TextDisabled}" Margin="12,0"/>
                </Border>

                <Label Text="{tr:Translate Key=Create_Description}" FontSize="13"
                       TextColor="{StaticResource TextSecondary}" Margin="0,8,0,4"/>
                <Border Stroke="{StaticResource BorderMedium}" StrokeThickness="1" BackgroundColor="{StaticResource SurfaceCardAlt}"
                        StrokeShape="RoundRectangle 10">
                    <Editor Text="{Binding Description}"
                            Placeholder="{tr:Translate Key=Create_DescriptionPlaceholder}"
                            PlaceholderColor="{StaticResource TextDisabled}" HeightRequest="80" Margin="12,4"/>
                </Border>

                <!-- Photo simple -->
                <VerticalStackLayout IsVisible="{Binding IsPhotoVote}" Spacing="12">
                    <Label Text="{tr:Translate Key=Create_YourPhoto}" FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                    <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource BorderMedium}"
                            StrokeThickness="1" BackgroundColor="{StaticResource SurfaceCardAlt}" HeightRequest="200">
                        <Grid>
                            <Label Text="{tr:Translate Key=Create_TapPhoto}"
                                   HorizontalOptions="Center" VerticalOptions="Center"
                                   TextColor="{StaticResource TextDisabled}" FontSize="16"/>
                            <Image Source="{Binding PhotoPreview}" Aspect="AspectFill"/>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PickPhotoCommand}"/>
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Duel -->
                <VerticalStackLayout IsVisible="{Binding IsDuel}" Spacing="12">
                    <Label Text="{tr:Translate Key=Create_YourTwoPhotos}" FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 12"
                                Stroke="{StaticResource BorderMedium}" StrokeThickness="1"
                                BackgroundColor="{StaticResource SurfaceCardAlt}" HeightRequest="160">
                            <Grid>
                                <VerticalStackLayout HorizontalOptions="Center"
                                                     VerticalOptions="Center" Spacing="4">
                                    <Label Text="📷" FontSize="28" HorizontalOptions="Center"/>
                                    <Label Text="{tr:Translate Key=Create_PhotoA}"
                                           TextColor="{StaticResource TextDisabled}" FontSize="13" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                                <Image Source="{Binding PhotoLeftPreview}" Aspect="AspectFill"/>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding PickPhotoLeftCommand}"/>
                                </Grid.GestureRecognizers>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" StrokeShape="RoundRectangle 12"
                                Stroke="{StaticResource BorderMedium}" StrokeThickness="1"
                                BackgroundColor="{StaticResource SurfaceCardAlt}" HeightRequest="160">
                            <Grid>
                                <VerticalStackLayout HorizontalOptions="Center"
                                                     VerticalOptions="Center" Spacing="4">
                                    <Label Text="📷" FontSize="28" HorizontalOptions="Center"/>
                                    <Label Text="{tr:Translate Key=Create_PhotoB}"
                                           TextColor="{StaticResource TextDisabled}" FontSize="13" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                                <Image Source="{Binding PhotoRightPreview}" Aspect="AspectFill"/>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding PickPhotoRightCommand}"/>
                                </Grid.GestureRecognizers>
                            </Grid>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- ✅ SONDAGE - Options -->
                <VerticalStackLayout IsVisible="{Binding IsPoll}" Spacing="12">
                    <Label Text="Options du sondage" FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                    <Label Text="{tr:Translate Key=CreateProject_PollRule}"
                           FontSize="11" TextColor="{StaticResource TextTertiary}"/>

                    <!-- Option 1 (toujours visible) -->
                    <Border Stroke="{StaticResource BorderMedium}" StrokeThickness="1" BackgroundColor="{StaticResource SurfaceCardAlt}"
                            StrokeShape="RoundRectangle 10">
                        <Entry Text="{Binding PollOption1}" Placeholder="{tr:Translate Key=CreateProject_PollOpt1}"
                               PlaceholderColor="{StaticResource TextDisabled}" Margin="12,0"/>
                    </Border>

                    <!-- Option 2 (toujours visible) -->
                    <Border Stroke="{StaticResource BorderMedium}" StrokeThickness="1" BackgroundColor="{StaticResource SurfaceCardAlt}"
                            StrokeShape="RoundRectangle 10">
                        <Entry Text="{Binding PollOption2}" Placeholder="{tr:Translate Key=CreateProject_PollOpt2}"
                               PlaceholderColor="{StaticResource TextDisabled}" Margin="12,0"/>
                    </Border>

                    <!-- Option 3 -->
                    <Border IsVisible="{Binding ShowOption3}" Stroke="{StaticResource BorderMedium}"
                            StrokeThickness="1" BackgroundColor="{StaticResource SurfaceCardAlt}"
                            StrokeShape="RoundRectangle 10">
                        <Entry Text="{Binding PollOption3}" Placeholder="{tr:Translate Key=CreateProject_PollOpt3}"
                               PlaceholderColor="{StaticResource TextDisabled}" Margin="12,0"/>
                    </Border>

                    <!-- Option 4 -->
                    <Border IsVisible="{Binding ShowOption4}" Stroke="{StaticResource BorderMedium}"
                            StrokeThickness="1" BackgroundColor="{StaticResource SurfaceCardAlt}"
                            StrokeShape="RoundRectangle 10">
                        <Entry Text="{Binding PollOption4}" Placeholder="{tr:Translate Key=CreateProject_PollOpt4}"
                               PlaceholderColor="{StaticResource TextDisabled}" Margin="12,0"/>
                    </Border>

                    <!-- Option 5 -->
                    <Border IsVisible="{Binding ShowOption5}" Stroke="{StaticResource BorderMedium}"
                            StrokeThickness="1" BackgroundColor="{StaticResource SurfaceCardAlt}"
                            StrokeShape="RoundRectangle 10">
                        <Entry Text="{Binding PollOption5}" Placeholder="{tr:Translate Key=CreateProject_PollOpt5}"
                               PlaceholderColor="{StaticResource TextDisabled}" Margin="12,0"/>
                    </Border>

                    <!-- Option 6 -->
                    <Border IsVisible="{Binding ShowOption6}" Stroke="{StaticResource BorderMedium}"
                            StrokeThickness="1" BackgroundColor="{StaticResource SurfaceCardAlt}"
                            StrokeShape="RoundRectangle 10">
                        <Entry Text="{Binding PollOption6}" Placeholder="{tr:Translate Key=CreateProject_PollOpt6}"
                               PlaceholderColor="{StaticResource TextDisabled}" Margin="12,0"/>
                    </Border>

                    <!-- Boutons ajouter / retirer -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Text="{tr:Translate Key=CreateProject_AddOption}"
                                Command="{Binding AddPollOptionCommand}"
                                IsEnabled="{Binding CanAddOption}"
                                BackgroundColor="{StaticResource SuccessLight}"
                                TextColor="{StaticResource Success}"
                                CornerRadius="8" HeightRequest="40" FontSize="13"/>
                        <Button Grid.Column="1"
                                Text="{tr:Translate Key=CreateProject_RemoveOption}"
                                Command="{Binding RemovePollOptionCommand}"
                                IsEnabled="{Binding CanRemoveOption}"
                                BackgroundColor="{StaticResource ErrorLight}"
                                TextColor="{StaticResource Error}"
                                CornerRadius="8" HeightRequest="40" FontSize="13"/>
                    </Grid>
                </VerticalStackLayout>

                <!-- Erreur -->
                <Border IsVisible="{Binding HasError}" BackgroundColor="{StaticResource ErrorLight}"
                        Stroke="{StaticResource Error}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 8" Padding="12,8">
                    <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Error}" FontSize="13"/>
                </Border>

                <Label Text="{Binding UploadProgress}" IsVisible="{Binding IsLoading}"
                       TextColor="{StaticResource Primary}" FontSize="13" HorizontalOptions="Center"/>

                <Button Text="{tr:Translate Key=Create_Submit}"
                        Command="{Binding SubmitProjectCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource TextOnPrimary}"
                        CornerRadius="10" HeightRequest="50"
                        FontSize="16" FontAttributes="Bold"/>

                <Button Text="{tr:Translate Key=Common_Back}"
                        Command="{Binding GoBackCommand}"
                        BackgroundColor="{StaticResource SurfaceMuted}"
                        TextColor="{StaticResource TextPrimary}"
                        CornerRadius="10" HeightRequest="45"/>

                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}" Color="{StaticResource Primary}"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
