<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BeauOuPas.Views.Profile.FeedbackPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:BeauOuPas.ViewModels.Profile"
    xmlns:tr="clr-namespace:BeauOuPas.Extensions"
    x:DataType="vm:FeedbackViewModel"
    Title="{tr:Translate Key=Feedback_Title}"
    BackgroundColor="{StaticResource BackgroundPage}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="{tr:Translate Key=Feedback_Subtitle}"
                   FontSize="16" TextColor="{StaticResource TextPrimary}"
                   HorizontalOptions="Center" HorizontalTextAlignment="Center"/>

            <!-- Étoiles -->
            <Border BackgroundColor="{StaticResource SurfaceCardAlt}" StrokeShape="RoundRectangle 12"
                    Stroke="{StaticResource BorderLight}" StrokeThickness="1" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{tr:Translate Key=Feedback_Rating}"
                           FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}"/>
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                        <Button Text="⭐" Command="{Binding SetRatingCommand}" CommandParameter="1"
                                BackgroundColor="{Binding Star1Color}" TextColor="{StaticResource TextOnPrimary}"
                                CornerRadius="8" HeightRequest="44" WidthRequest="44" FontSize="20" Padding="0"/>
                        <Button Text="⭐" Command="{Binding SetRatingCommand}" CommandParameter="2"
                                BackgroundColor="{Binding Star2Color}" TextColor="{StaticResource TextOnPrimary}"
                                CornerRadius="8" HeightRequest="44" WidthRequest="44" FontSize="20" Padding="0"/>
                        <Button Text="⭐" Command="{Binding SetRatingCommand}" CommandParameter="3"
                                BackgroundColor="{Binding Star3Color}" TextColor="{StaticResource TextOnPrimary}"
                                CornerRadius="8" HeightRequest="44" WidthRequest="44" FontSize="20" Padding="0"/>
                        <Button Text="⭐" Command="{Binding SetRatingCommand}" CommandParameter="4"
                                BackgroundColor="{Binding Star4Color}" TextColor="{StaticResource TextOnPrimary}"
                                CornerRadius="8" HeightRequest="44" WidthRequest="44" FontSize="20" Padding="0"/>
                        <Button Text="⭐" Command="{Binding SetRatingCommand}" CommandParameter="5"
                                BackgroundColor="{Binding Star5Color}" TextColor="{StaticResource TextOnPrimary}"
                                CornerRadius="8" HeightRequest="44" WidthRequest="44" FontSize="20" Padding="0"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Message -->
            <Border BackgroundColor="{StaticResource SurfaceCardAlt}" StrokeShape="RoundRectangle 12"
                    Stroke="{StaticResource BorderLight}" StrokeThickness="1" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{tr:Translate Key=Feedback_Message}"
                           FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}"/>
                    <Editor Text="{Binding Message}"
                            Placeholder="{tr:Translate Key=Feedback_Placeholder}"
                            PlaceholderColor="{StaticResource TextDisabled}" HeightRequest="120"/>
                </VerticalStackLayout>
            </Border>

            <!-- Erreur -->
            <Border IsVisible="{Binding HasError}" BackgroundColor="{StaticResource ErrorLight}"
                    Stroke="{StaticResource Error}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 8" Padding="12,8">
                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Error}" FontSize="13"/>
            </Border>

            <Button Text="{tr:Translate Key=Feedback_Send}"
                    Command="{Binding SendFeedbackCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="{StaticResource TextOnPrimary}"
                    CornerRadius="12" HeightRequest="52"
                    FontSize="16" FontAttributes="Bold"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"/>

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="{StaticResource Primary}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
