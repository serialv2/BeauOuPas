<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="BeauOuPas.Views.Shared.ProjectDetailPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:BeauOuPas.ViewModels"
    xmlns:conv="clr-namespace:BeauOuPas.Converters"
    xmlns:models="clr-namespace:BeauOuPas.Models"
        xmlns:tr="clr-namespace:BeauOuPas.Extensions"
x:DataType="vm:ProjectDetailViewModel"
    IsVisible="{Binding IsVisible}">

    <ContentView.Resources>
        <conv:PctToProgressConverter x:Key="PctToProgressConverter"/>
    </ContentView.Resources>

    <Grid>

        <!-- Fond sombre cliquable pour fermer -->
        <BoxView BackgroundColor="#CC000000"
                 HorizontalOptions="Fill"
                 VerticalOptions="Fill">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseCommand}"/>
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Carte centrale -->
        <Border BackgroundColor="{StaticResource DarkSurface}"
                StrokeShape="RoundRectangle 20"
                Stroke="{StaticResource DarkBorder}"
                StrokeThickness="1"
                HorizontalOptions="Fill"
                VerticalOptions="Center"
                Margin="20,60">

            <ScrollView MaximumHeightRequest="600">
                <VerticalStackLayout Spacing="0">

                    <!-- Photo vote -->
                    <Grid IsVisible="{Binding IsPhoto}"
                          HeightRequest="260">
                        <Image Source="{Binding PhotoUrl}"
                               Aspect="AspectFill"/>
                        <Border BackgroundColor="#CC000000"
                                StrokeShape="RoundRectangle 0"
                                Padding="16,8"
                                VerticalOptions="End">
                            <Label Text="{Binding Title}"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="White"/>
                        </Border>
                    </Grid>

                    <!-- Duel -->
                    <Grid IsVisible="{Binding IsDuel}"
                          ColumnDefinitions="*,*"
                          HeightRequest="260">
                        <Image Grid.Column="0"
                               Source="{Binding PhotoLeftUrl}"
                               Aspect="AspectFill"/>
                        <Border Grid.Column="0"
                                BackgroundColor="#CC000000"
                                StrokeShape="RoundRectangle 0"
                                Padding="8,4"
                                VerticalOptions="End">
                            <Label Text="A" TextColor="White"
                                   FontSize="14" FontAttributes="Bold"
                                   HorizontalOptions="Center"/>
                        </Border>
                        <Image Grid.Column="1"
                               Source="{Binding PhotoRightUrl}"
                               Aspect="AspectFill"/>
                        <Border Grid.Column="1"
                                BackgroundColor="#CC000000"
                                StrokeShape="RoundRectangle 0"
                                Padding="8,4"
                                VerticalOptions="End">
                            <Label Text="B" TextColor="White"
                                   FontSize="14" FontAttributes="Bold"
                                   HorizontalOptions="Center"/>
                        </Border>
                        <Border Grid.ColumnSpan="2"
                                BackgroundColor="#CC000000"
                                StrokeShape="RoundRectangle 0"
                                Padding="16,8"
                                VerticalOptions="Start">
                            <Label Text="{Binding Title}"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="White"/>
                        </Border>
                    </Grid>

                    <!-- ⚡ MAI 2026 — FIX B3 : Sondage (poll) -->
                    <!-- Pas d'image principale pour les sondages, juste un header
                         coloré avec le titre. Le contenu (options + stats) est
                         dans le bloc HasPollStats plus bas. -->
                    <Border IsVisible="{Binding IsPoll}"
                            HeightRequest="100"
                            BackgroundColor="{StaticResource DarkSurface}"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 0">
                        <VerticalStackLayout VerticalOptions="Center"
                                             Padding="20,12"
                                             Spacing="6">
                            <Label Text="{tr:Translate Key=ProjectDetail_Poll}"
                                   FontSize="12"
                                   TextColor="{StaticResource Primary}"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Start"/>
                            <Label Text="{Binding Title}"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Infos owner -->
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          Padding="16,12"
                          ColumnSpacing="12">

                        <Border Grid.Column="0"
                                StrokeShape="Ellipse"
                                Stroke="{StaticResource Primary}"
                                StrokeThickness="2"
                                HeightRequest="48"
                                WidthRequest="48">
                            <Image Source="{Binding OwnerAvatar}"
                                   Aspect="AspectFill"
                                   HeightRequest="48"
                                   WidthRequest="48"/>
                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                                             VerticalOptions="Center"
                                             Spacing="2">
                            <Label Text="{Binding OwnerUsername}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="White"/>
                            <Label Text="{Binding OwnerAge,
                                       StringFormat='{0} ans'}"
                                   FontSize="13"
                                   TextColor="{StaticResource TextDisabled}"/>
                        </VerticalStackLayout>

                        <Border Grid.Column="2"
                                BackgroundColor="{StaticResource TextPrimary}"
                                StrokeShape="Ellipse"
                                Stroke="Transparent"
                                HeightRequest="36"
                                WidthRequest="36"
                                VerticalOptions="Center">
                            <Label Text="✕"
                                   FontSize="16"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding CloseCommand}"/>
                            </Border.GestureRecognizers>
                        </Border>

                    </Grid>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{StaticResource TextPrimary}"
                             Margin="16,0"/>

                    <!-- Chargement -->
                    <ActivityIndicator
                        IsRunning="{Binding IsLoading}"
                        IsVisible="{Binding IsLoading}"
                        Color="{StaticResource Primary}"
                        HeightRequest="60"
                        HorizontalOptions="Center"/>

                    <!-- Stats photo vote -->
                    <VerticalStackLayout
                        IsVisible="{Binding HasPhotoStats}"
                        Padding="16,12"
                        Spacing="12">

                        <Grid ColumnDefinitions="*,*">
                            <VerticalStackLayout Grid.Column="0"
                                                 HorizontalOptions="Center"
                                                 Spacing="2">
                                <Label Text="{Binding PhotoStats.TotalVotes}"
                                       FontSize="26" FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"/>
                                <Label Text="{tr:Translate Key=ProjectDetail_Votes}" FontSize="12"
                                       TextColor="{StaticResource TextDisabled}"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1"
                                                 HorizontalOptions="Center"
                                                 Spacing="2">
                                <Label Text="{Binding PhotoStats.ScoreMoyen,
                                           StringFormat='{0:F1}'}"
                                       FontSize="26" FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       HorizontalOptions="Center"/>
                                <Label Text="{tr:Translate Key=ProjectDetail_AvgScore}" FontSize="12"
                                       TextColor="{StaticResource TextDisabled}"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Grid>

                        <Label Text="{tr:Translate Key=ProjectDetail_Distribution}" FontSize="13"
                               FontAttributes="Bold" TextColor="{StaticResource TextDisabled}"/>

                        <Grid ColumnDefinitions="24,*,40" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="❤️" FontSize="14"
                                   VerticalOptions="Center"/>
                            <ProgressBar Grid.Column="1"
                                Progress="{Binding PhotoStats.PctJaime,
                                    Converter={StaticResource PctToProgressConverter}}"
                                ProgressColor="{StaticResource Success}"
                                VerticalOptions="Center"/>
                            <Label Grid.Column="2"
                                Text="{Binding PhotoStats.PctJaime,
                                    StringFormat='{0:F0}%'}"
                                FontSize="12" TextColor="White"
                                HorizontalOptions="End"
                                VerticalOptions="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="24,*,40" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="😐" FontSize="14"
                                   VerticalOptions="Center"/>
                            <ProgressBar Grid.Column="1"
                                Progress="{Binding PhotoStats.PctMoyen,
                                    Converter={StaticResource PctToProgressConverter}}"
                                ProgressColor="{StaticResource Warning}"
                                VerticalOptions="Center"/>
                            <Label Grid.Column="2"
                                Text="{Binding PhotoStats.PctMoyen,
                                    StringFormat='{0:F0}%'}"
                                FontSize="12" TextColor="White"
                                HorizontalOptions="End"
                                VerticalOptions="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="24,*,40" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="👎" FontSize="14"
                                   VerticalOptions="Center"/>
                            <ProgressBar Grid.Column="1"
                                Progress="{Binding PhotoStats.PctPasFan,
                                    Converter={StaticResource PctToProgressConverter}}"
                                ProgressColor="{StaticResource Error}"
                                VerticalOptions="Center"/>
                            <Label Grid.Column="2"
                                Text="{Binding PhotoStats.PctPasFan,
                                    StringFormat='{0:F0}%'}"
                                FontSize="12" TextColor="White"
                                HorizontalOptions="End"
                                VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource TextPrimary}"/>

                        <Label Text="{tr:Translate Key=ProjectDetail_Voters}" FontSize="13"
                               FontAttributes="Bold" TextColor="{StaticResource TextDisabled}"/>

                        <Grid ColumnDefinitions="80,*,40" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="{tr:Translate Key=ProjectDetail_Men}"
                                   FontSize="12" TextColor="White"
                                   VerticalOptions="Center"/>
                            <ProgressBar Grid.Column="1"
                                Progress="{Binding PhotoStats.PctHommes,
                                    Converter={StaticResource PctToProgressConverter}}"
                                ProgressColor="{StaticResource Info}"
                                VerticalOptions="Center"/>
                            <Label Grid.Column="2"
                                Text="{Binding PhotoStats.PctHommes,
                                    StringFormat='{0:F0}%'}"
                                FontSize="12" TextColor="White"
                                HorizontalOptions="End"
                                VerticalOptions="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="80,*,40" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="{tr:Translate Key=ProjectDetail_Women}"
                                   FontSize="12" TextColor="White"
                                   VerticalOptions="Center"/>
                            <ProgressBar Grid.Column="1"
                                Progress="{Binding PhotoStats.PctFemmes,
                                    Converter={StaticResource PctToProgressConverter}}"
                                ProgressColor="{StaticResource Primary}"
                                VerticalOptions="Center"/>
                            <Label Grid.Column="2"
                                Text="{Binding PhotoStats.PctFemmes,
                                    StringFormat='{0:F0}%'}"
                                FontSize="12" TextColor="White"
                                HorizontalOptions="End"
                                VerticalOptions="Center"/>
                        </Grid>

                    </VerticalStackLayout>

                    <!-- Stats duel -->
                    <VerticalStackLayout
                        IsVisible="{Binding HasDuelStats}"
                        Padding="16,12"
                        Spacing="12">

                        <VerticalStackLayout HorizontalOptions="Center"
                                             Spacing="2">
                            <Label Text="{Binding DuelStats.TotalVotes}"
                                   FontSize="26" FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center"/>
                            <Label Text="{tr:Translate Key=ProjectDetail_Votes}" FontSize="12"
                                   TextColor="{StaticResource TextDisabled}"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <Label Text="{tr:Translate Key=ProjectDetail_AvsB}" FontSize="13"
                               FontAttributes="Bold" TextColor="{StaticResource TextDisabled}"/>

                        <Grid ColumnDefinitions="24,*,40" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="A"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="White"
                                   VerticalOptions="Center"/>
                            <ProgressBar Grid.Column="1"
                                Progress="{Binding DuelStats.PctLeft,
                                    Converter={StaticResource PctToProgressConverter}}"
                                ProgressColor="{StaticResource Accent}"
                                VerticalOptions="Center"/>
                            <Label Grid.Column="2"
                                Text="{Binding DuelStats.PctLeft,
                                    StringFormat='{0:F0}%'}"
                                FontSize="12" TextColor="White"
                                HorizontalOptions="End"
                                VerticalOptions="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="24,*,40" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="B"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="White"
                                   VerticalOptions="Center"/>
                            <ProgressBar Grid.Column="1"
                                Progress="{Binding DuelStats.PctRight,
                                    Converter={StaticResource PctToProgressConverter}}"
                                ProgressColor="{StaticResource Primary}"
                                VerticalOptions="Center"/>
                            <Label Grid.Column="2"
                                Text="{Binding DuelStats.PctRight,
                                    StringFormat='{0:F0}%'}"
                                FontSize="12" TextColor="White"
                                HorizontalOptions="End"
                                VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource TextPrimary}"/>

                        <Label Text="{tr:Translate Key=ProjectDetail_Voters}" FontSize="13"
                               FontAttributes="Bold" TextColor="{StaticResource TextDisabled}"/>

                        <Grid ColumnDefinitions="80,*,40" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="{tr:Translate Key=ProjectDetail_Men}"
                                   FontSize="12" TextColor="White"
                                   VerticalOptions="Center"/>
                            <ProgressBar Grid.Column="1"
                                Progress="{Binding DuelStats.PctHommes,
                                    Converter={StaticResource PctToProgressConverter}}"
                                ProgressColor="{StaticResource Info}"
                                VerticalOptions="Center"/>
                            <Label Grid.Column="2"
                                Text="{Binding DuelStats.PctHommes,
                                    StringFormat='{0:F0}%'}"
                                FontSize="12" TextColor="White"
                                HorizontalOptions="End"
                                VerticalOptions="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="80,*,40" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="{tr:Translate Key=ProjectDetail_Women}"
                                   FontSize="12" TextColor="White"
                                   VerticalOptions="Center"/>
                            <ProgressBar Grid.Column="1"
                                Progress="{Binding DuelStats.PctFemmes,
                                    Converter={StaticResource PctToProgressConverter}}"
                                ProgressColor="{StaticResource Primary}"
                                VerticalOptions="Center"/>
                            <Label Grid.Column="2"
                                Text="{Binding DuelStats.PctFemmes,
                                    StringFormat='{0:F0}%'}"
                                FontSize="12" TextColor="White"
                                HorizontalOptions="End"
                                VerticalOptions="Center"/>
                        </Grid>

                    </VerticalStackLayout>

                    <!-- ⚡ MAI 2026 — FIX B3 : Stats sondage (poll) -->
                    <!-- Affiche chaque option avec sa barre de progression
                         et son pourcentage. PollStats est une List<PollOption>
                         remplie par LoadStatsAsync. -->
                    <VerticalStackLayout IsVisible="{Binding HasPollStats}"
                                         Padding="16,12"
                                         Spacing="14">

                        <!-- Total des votes en haut -->
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                            <Label Text="{Binding PollStats.Count, StringFormat='{0} options'}"
                                   FontSize="11" TextColor="{StaticResource TextDisabled}"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource TextPrimary}"/>

                        <Label Text="{tr:Translate Key=ProjectDetail_VotesDistribution}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextDisabled}"/>

                        <!-- Liste des options (CollectionView pour binder PollStats) -->
                        <CollectionView ItemsSource="{Binding PollStats}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:PollOption">
                                    <VerticalStackLayout Spacing="4" Padding="0,4">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Text}"
                                                   FontSize="14"
                                                   TextColor="White"
                                                   LineBreakMode="WordWrap"
                                                   VerticalOptions="Center"/>
                                            <Label Grid.Column="1"
                                                   Text="{Binding Percentage, StringFormat='{0:F0}%'}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Primary}"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                        <ProgressBar Progress="{Binding Percentage,
                                                       Converter={StaticResource PctToProgressConverter}}"
                                                     ProgressColor="{StaticResource Primary}"
                                                     HeightRequest="6"/>
                                        <Label Text="{Binding VoteCount, StringFormat='{0} vote(s)'}"
                                               FontSize="11"
                                               TextColor="{StaticResource TextTertiary}"/>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>

                    <!-- Aucune stat -->
                    <Label IsVisible="{Binding NoStats}"
                           Text="{tr:Translate Key=ProjectDetail_NoVoteYet}"
                           FontSize="14" TextColor="{StaticResource TextDisabled}"
                           HorizontalOptions="Center"
                           Padding="16,16"/>

                    <BoxView HeightRequest="8"/>

                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentView>
