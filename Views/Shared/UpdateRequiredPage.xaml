<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BeauOuPas.Views.Shared.UpdateRequiredPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:tr="clr-namespace:BeauOuPas.Extensions"
    BackgroundColor="{StaticResource DarkBackground}"
    Shell.NavBarIsVisible="False">

    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                         Spacing="24" Padding="40">

        <Label Text="🆕" FontSize="72" HorizontalOptions="Center"/>

        <Label Text="BeauOuPas"
               FontSize="28" FontAttributes="Bold"
               TextColor="{StaticResource Primary}" HorizontalOptions="Center"/>

        <Label Text="{tr:Translate Key=Update_Title}"
               FontSize="20" FontAttributes="Bold"
               TextColor="{StaticResource DarkTextPrimary}" HorizontalOptions="Center"/>

        <Label Text="{tr:Translate Key=Update_Message}"
               FontSize="14" TextColor="{StaticResource DarkTextSecondary}"
               HorizontalOptions="Center" HorizontalTextAlignment="Center"/>

        <Button Text="{tr:Translate Key=Update_Button}"
                x:Name="UpdateButton"
                BackgroundColor="{StaticResource Primary}"
                TextColor="{StaticResource TextOnPrimary}"
                CornerRadius="12" HeightRequest="52"
                FontSize="16" FontAttributes="Bold"/>
    </VerticalStackLayout>
</ContentPage>
